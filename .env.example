# Copiar como .env.local y completar.

# --- Desarrollo local con los emuladores de Firebase (no toca datos reales) ---
# Con estos valores la app usa Auth y Firestore emulados (ver firebase.json y docs/MEJORAS-MAPAS.md).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-asamblea.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-asamblea
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-asamblea.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# --- Producción ---
# Quitar NEXT_PUBLIC_USE_FIREBASE_EMULATORS (o ponerlo en false) y usar la configuración
# web del proyecto de Firebase real (Consola de Firebase > Configuración del proyecto).

# Subida de imágenes de banners/categorías a ImgBB (opcional en local)
NEXT_PUBLIC_IMGBB_API_KEY=
